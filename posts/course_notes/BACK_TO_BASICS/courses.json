      "id": "information-theory",
      "title": "Information Theory",
      "tier": "Undergraduate Major Courses",
      "state": "v1.1",
      "prerequisites": [
        "calculus",
        "probability"
      ],
      "insights": "NULL.",
      "recommendations": [
        {
          "title": "[Chinese] Introduction of Communication Systems",
          "provider": "Professor Po-Ning Chen, NYCU EE.",
          "description": "The purpose of this course is to present a concise, yet mathematically rigorous, introduction to the main pillars of information theory. It thus naturally focuses on the foundational concepts and indispensable results of the subject for single-user systems, where a single data source or message needs to be reliably processed and communicated over a noiseless or noisy point-to-point channel. At the first part of this course, six meticulously core chapters with accompanying problems, emphasizing the key topics of information measures, lossless and lossy data compression, channel coding, and joint source-channel coding. Two appendices covering necessary and supplementary material in real analysis and in probability and stochastic processes are included. At the second part of the course, advanced topics concerning the information theoretic limits of discrete-time single-user stochastic systems with arbitrary statistical memory (i.e., systems that are not necessarily stationary, ergodic or information stable) will be covered.",
          "links": [
            {
              "label": "Information",
              "url": "https://ocw.nycu.edu.tw/?post_type=course_page&p=70660"
            },
            {
              "label": "Youtube",
              "url": "https://www.youtube.com/playlist?list=PLj6E8qlqmkFsWS54o6gNWeDGXeI7c3eUd"
            },
